# ========================================================
# AI Timesheet Assistant - Environment Configuration Example
# ========================================================
# NOTE: When deployed to GitHub Pages (static hosting), secrets should NEVER
# be hardcoded into frontend HTML/JS files.
#
# You have two secure deployment options:
#
# OPTION 1 (Recommended for pure GitHub Pages):
# Configure your Google Apps Script Web App URL and AI API key directly
# in the in-app Settings modal. The key is securely stored only in your
# browser's LocalStorage and is never committed to GitHub or exposed.
#
# OPTION 2 (Enterprise / Team proxy):
# Store your AI API key securely in Google Apps Script Script Properties
# (Project Settings -> Script Properties -> AI_API_KEY) and let your Apps Script
# Web App proxy the AI calls.
# ========================================================

# Google Apps Script Web App URL (deployed with access: "Anyone")
# Format: https://script.google.com/macros/s/AKfycb.../exec
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_APPS_SCRIPT_DEPLOYMENT_ID/exec

# AI Provider ("gemini" | "openai" | "anthropic" | "custom" | "builtin")
AI_PROVIDER=gemini

# AI API Key (e.g. Google Gemini API Key)
AI_API_KEY=your_gemini_api_key_here

# AI Model Name
# Gemini: gemini-1.5-flash or gemini-2.0-flash
# OpenAI: gpt-4o-mini or gpt-4o
AI_MODEL=gemini-3.8-flash

# Google Spreadsheet Configuration
GOOGLE_SPREADSHEET_ID=1Z1UCvEUKEiVwqbnhsVFuSBakf0QlpNocZnvcH70wC_c
SHEET_TIMESHEET_NAME=Time Log
SHEET_REQUIREMENT_MASTER_NAME=Requirement Master
SHEET_TASK_TYPE_MASTER_NAME=Task Type Master
